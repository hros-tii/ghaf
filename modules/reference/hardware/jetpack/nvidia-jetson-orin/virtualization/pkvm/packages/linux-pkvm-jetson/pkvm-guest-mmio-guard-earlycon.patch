+/*
+ * earlycon is mapped through the fixmap before MMIO guard enrolment, so the
+ * ioremap hook never sees it. Map it right after enrolling, before the next
+ * printk reaches the UART, or that access faults and the guest deadlocks.
+ */
+static void mmio_guard_map_earlycon(void)
+{
+	unsigned long addr = __fix_to_virt(FIX_EARLYCON_MEM_BASE);
+	u32 func_id = pkvm_func_range ?
+		ARM_SMCCC_VENDOR_HYP_KVM_MMIO_RGUARD_MAP_FUNC_ID :
+		ARM_SMCCC_VENDOR_HYP_KVM_MMIO_GUARD_MAP_FUNC_ID;
+	pmd_t *pmdp = pmd_off_k(addr);
+	pte_t pte;
+
+	if (pmd_none(READ_ONCE(*pmdp)))
+		return;
+
+	pte = __ptep_get(pte_offset_kernel(pmdp, addr));
+	if (!pte_present(pte))
+		return;
+
+	arm_smccc_do_range(func_id, ALIGN_DOWN(PFN_PHYS(pte_pfn(pte)), pkvm_granule),
+			   pkvm_granule >> PAGE_SHIFT, pkvm_func_range);
+}
+
 void pkvm_init_hyp_services(void)
 {
